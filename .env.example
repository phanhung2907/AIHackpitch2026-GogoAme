# TapOrder Backend Environment Example (Safe Placeholders Only — Copy to .env locally)
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEMO_TIMEZONE=Asia/Bangkok
ENABLE_MOCKS=false

# PostgreSQL Dev & Isolated Test Databases
DATABASE_URL=postgresql+psycopg://taporder:REPLACE_WITH_DEV_DB_PASSWORD@127.0.0.1:5432/taporder_dev
TEST_DATABASE_URL=postgresql+psycopg://taporder_test:REPLACE_WITH_TEST_DB_PASSWORD@127.0.0.1:5433/taporder_test

# Security & Capability Encryption (Generate 32-byte random secrets for real usage)
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_BYTE_RANDOM_SESSION_SECRET
QR_ENCRYPTION_KEY=k1:REPLACE_WITH_BASE64URL_ENCODED_32_BYTE_AES_KEY

# Origins, Hosts, and Cookie Flags
PUBLIC_BASE_URL=http://127.0.0.1:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080
ALLOWED_HOSTS=127.0.0.1,localhost
COOKIE_SECURE=false

# Seed Staff Passwords (Used only by `python -m app.seed`; never logged or committed)
DEMO_BARISTA_PASSWORD=REPLACE_WITH_BARISTA_DEMO_PASSWORD
DEMO_CASHIER_PASSWORD=REPLACE_WITH_CASHIER_DEMO_PASSWORD
DEMO_EXPORT_ACCOUNTS_PATH=.local-tools/demo/accounts.txt

